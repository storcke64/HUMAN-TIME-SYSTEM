<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Human Time System (HTS) Converter</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f0f4f8;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            color: #333;
            padding: 20px;
            box-sizing: border-box; 
        }
        .container {
            background: #fff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
            text-align: center;
            width: 100%;
            max-width: 500px;
        }
        h2 {
            color: #3f51b5;
            margin-bottom: 25px;
            font-size: 1.6em;
            font-weight: 600;
        }
        .input-group {
            margin-bottom: 25px;
            text-align: left;
        }
        .input-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #555;
            font-size: 1.1em;
        }
        .input-group input[type="number"] {
            padding: 12px 15px;
            width: 100%;
            border: 1px solid #cdd5df;
            border-radius: 8px;
            font-size: 1.1em;
            box-sizing: border-box;
        }
        .input-group .note {
            font-size: 0.9em;
            color: #6a7c8e;
            margin-top: 5px;
            display: block;
        }
        button {
            background-color: #4285f4;
            color: white;
            padding: 14px 25px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1.2em;
            font-weight: 600;
            width: 100%;
            transition: background-color 0.3s ease;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        }
        button:hover {
            background-color: #357ae8;
        }
        .results-section {
            margin-top: 30px;
            text-align: left;
        }
        .result-box {
            background-color: #e8f5e9;
            border: 1px solid #a5d6a7;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 15px;
            font-size: 1.1em;
            font-weight: bold;
            color: #2e7d32;
        }
        .result-box.gregorian {
            background-color: #e3f2fd;
            border: 1px solid #90caf9;
            color: #1976d2;
        }
        .result-box strong {
            display: block;
            font-size: 1.3em;
            margin-top: 5px;
            color: #000;
        }
        .info-section {
            margin-top: 25px;
            text-align: left;
            font-size: 0.95em;
            color: #6a7c8e;
            line-height: 1.6;
        }
        .info-section div {
            margin-bottom: 5px;
        }
        .info-section strong {
            color: #333;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>HTS Deep-Time Calculator</h2>
    <p style="font-size: 0.9em; color: #6a7c8e; margin-top: -15px; margin-bottom: 25px;">
        Calculate future years based upon the Storcke Human Time System (HTS) Epoch rules (A-Z cycle, 50,000 years per Epoch)
    </p>
    
    <div class="input-group">
        <label for="specificYear">Enter Specific Gregorian Year</label>
        <input type="number" id="specificYear" placeholder="Enter any year (e.g., 1969, -500 for 500 BC)">
        <span class="note">Enter positive numbers for CE years, negative for BC years (e.g., -500 = 500 BC).</span>
    </div>
    
    <button onclick="calculateSpecificYear()">Convert Specific Year</button>
    
    <div class="results-section">
        <div id="specificHtsResult" class="result-box">
            HTS CALENDAR YEAR<br>
            <strong>Enter a year above</strong>
        </div>
        <div id="specificGregorianResult" class="result-box gregorian">
            GREGORIAN YEAR<br>
            <strong>-</strong>
        </div>
    </div>
    
    <hr style="margin: 40px 0; border: none; border-top: 2px solid #e0e0e0;">
    
    <div class="input-group">
        <label for="gregorianYear">Years to Calculate From Today (Annus)</label>
        <input type="number" id="gregorianYear" placeholder="Enter Gregorian Year (e.g., 2025)">
        <span class="note">Note: This year is A40002.</span>
    </div>
    
    <button onclick="calculateHTS()">Calculate Future Date</button>
    
    <div class="results-section">
        <div id="htsResultBox" class="result-box">
            HTS CALENDAR YEAR<br>
            <strong>A40002</strong>
        </div>
        <div id="gregorianResultBox" class="result-box gregorian">
            GREGORIAN CE EQUIVALENT<br>
            <strong>2,025 CE</strong>
        </div>
    </div>

    <div class="info-section">
        <div>Start (A1): <strong>37977 BC</strong></div>
        <div>Current (A40002): <strong>2025 CE</strong></div>
        <div>Epoch Length: <strong>50,000 Annus</strong></div>
    </div>
</div>

<script>
    const HTS_OFFSET = 37977;
    const EPOCH_DURATION = 50000;
    const CURRENT_GREGORIAN_YEAR = 2025;

    function calculateSpecificYear() {
        const inputElement = document.getElementById('specificYear');
        const htsResultBox = document.getElementById('specificHtsResult');
        const gregorianResultBox = document.getElementById('specificGregorianResult');

        let inputYear = parseInt(inputElement.value);

        if (isNaN(inputYear)) {
            htsResultBox.innerHTML = `HTS CALENDAR YEAR<br><strong>Please enter a valid year.</strong>`;
            gregorianResultBox.innerHTML = `GREGORIAN YEAR<br><strong>N/A</strong>`;
            return;
        }

        // Adjust for no year zero in Gregorian calendar
        let adjustedYear = inputYear;
        if (inputYear <= 0) {
            adjustedYear = inputYear - 1;
        }

        // HTS Year Number calculation
        let totalHTSYear = adjustedYear + HTS_OFFSET;

        // Check against HTS system start
        if (totalHTSYear < 1) {
            let displayYear = adjustedYear < 0 ? `${Math.abs(adjustedYear)} BC` : `${adjustedYear} CE`;
            htsResultBox.innerHTML = `HTS CALENDAR YEAR<br><strong>Before HTS Start (A1)</strong>`;
            gregorianResultBox.innerHTML = `GREGORIAN YEAR<br><strong>${displayYear}</strong>`;
            return;
        }

        // Calculate epoch
        let epochIndex = Math.floor((totalHTSYear - 1) / EPOCH_DURATION);
        let letterCharCode = 'A'.charCodeAt(0) + (epochIndex % 26);
        let epochLetter = String.fromCharCode(letterCharCode);
        let yearInEpoch = totalHTSYear - (epochIndex * EPOCH_DURATION);
        let htsDate = `${epochLetter}${yearInEpoch}`;
        
        // Format Gregorian year display
        let gregorianDisplay = adjustedYear < 0 ? `${Math.abs(adjustedYear).toLocaleString()} BC` : `${adjustedYear.toLocaleString()} CE`;
        
        htsResultBox.innerHTML = `HTS CALENDAR YEAR<br><strong>${htsDate}</strong>`;
        gregorianResultBox.innerHTML = `GREGORIAN YEAR<br><strong>${gregorianDisplay}</strong>`;
    }

    function calculateHTS() {
        const inputElement = document.getElementById('gregorianYear');
        const htsResultBox = document.getElementById('htsResultBox');
        const gregorianResultBox = document.getElementById('gregorianResultBox');

        let yearsFromToday = parseInt(inputElement.value);

        if (isNaN(yearsFromToday)) {
            htsResultBox.innerHTML = `HTS CALENDAR YEAR<br><strong>Please enter a valid number.</strong>`;
            gregorianResultBox.innerHTML = `GREGORIAN CE EQUIVALENT<br><strong>N/A</strong>`;
            return;
        }

        // Calculate the target Gregorian year
        let targetGregorianYear = CURRENT_GREGORIAN_YEAR + yearsFromToday;

        // Adjust for no year zero in Gregorian calendar
        let adjustedYear = targetGregorianYear;
        if (targetGregorianYear <= 0) {
            adjustedYear = targetGregorianYear - 1;
        }

        // HTS Year Number calculation: Y_HTS = Y_G + Offset
        let totalHTSYear = adjustedYear + HTS_OFFSET;

        // Check against HTS system start (HTS Year 1)
        if (totalHTSYear < 1) {
             let displayYear = adjustedYear < 0 ? `${Math.abs(adjustedYear)} BC` : `${adjustedYear} CE`;
             htsResultBox.innerHTML = `HTS CALENDAR YEAR<br><strong>Year before 37977 BC.</strong>`;
             gregorianResultBox.innerHTML = `GREGORIAN CE EQUIVALENT<br><strong>${displayYear}</strong>`;
             return;
        }

        // 1. Calculate the Epoch Index (I): (Total HTS Year - 1) / EPOCH_DURATION
        let epochIndex = Math.floor((totalHTSYear - 1) / EPOCH_DURATION);

        // 2. Determine the Epoch Letter (A=0, B=1, etc. - using modulo 26 for cycles)
        let letterCharCode = 'A'.charCodeAt(0) + (epochIndex % 26);
        let epochLetter = String.fromCharCode(letterCharCode);

        // 3. Calculate the Year within the Epoch: Total HTS Year - (Index * Epoch Duration)
        let yearInEpoch = totalHTSYear - (epochIndex * EPOCH_DURATION);
        
        // 4. Format the final output
        let htsDate = `${epochLetter}${yearInEpoch}`;
        
        // Format Gregorian year display
        let gregorianDisplay = adjustedYear < 0 ? `${Math.abs(adjustedYear).toLocaleString()} BC` : `${adjustedYear.toLocaleString()} CE`;
        
        htsResultBox.innerHTML = `HTS CALENDAR YEAR<br><strong>${htsDate}</strong>`;
        gregorianResultBox.innerHTML = `GREGORIAN CE EQUIVALENT<br><strong>${gregorianDisplay}</strong>`;
    }

    document.getElementById('gregorianYear').value = 0;
    calculateHTS(); 
</script>

</body>
</html>
